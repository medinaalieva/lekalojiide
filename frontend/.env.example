# ==============================================================================
# LEKALO ZHIIDE FRONTEND — ПРИМЕР КОНФИГУРАЦИИ (.env.example)
# ==============================================================================

# Режим окружения
NODE_ENV=production

# Порт Next.js сервера (внутри контейнера)
PORT=3000

# Внутренний адрес Backend API для SSR (Server-Side Rendering) и Next.js rewrites
# В Docker Compose: имя сервиса backend
INTERNAL_API_URL="http://backend:4000"

# Публичный адрес API для браузера (используется при клиентских запросах вне rewrites)
NEXT_PUBLIC_API_URL="https://lekalo-zhiide.kg"
