# ==============================================================================
# LEKALO ZHIIDE — ПРИМЕР КОНФИГУРАЦИИ ОКРУЖЕНИЯ (.env.example)
# Рынок: Кыргызская Республика (Кыргызстан)
# Валюта: KGS (кыргызский сом)
# ==============================================================================

# Окружение приложения (development | production | test)
NODE_ENV=production

# Сетевой порт для HTTP API сервера
PORT=4000

# ------------------------------------------------------------------------------
# Домен и сетевые имена (для Caddy / Reverse Proxy и CORS)
# ------------------------------------------------------------------------------
DOMAIN=lekalo-zhiide.kg
CADDY_ACME_EMAIL=admin@lekalo-zhiide.kg

# ------------------------------------------------------------------------------
# База данных PostgreSQL 16+
# Для Docker Compose: хост — имя контейнера "postgres"
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-secure-db-password-at-least-16-chars
POSTGRES_DB=lekalo_zhiide
DATABASE_URL="postgresql://postgres:replace-with-secure-db-password-at-least-16-chars@postgres:5432/lekalo_zhiide?schema=public"
# Прямое подключение для миграций Prisma (для Neon / Serverless PostgreSQL)
DIRECT_URL="postgresql://postgres:replace-with-secure-db-password-at-least-16-chars@postgres:5432/lekalo_zhiide?schema=public"

# ------------------------------------------------------------------------------
# Безопасность и JWT (JSON Web Tokens)
# ВНИМАНИЕ ДЛЯ PRODUCTION: JWT_SECRET должен быть криптостойкой строкой
# длиной не менее 32 символов (сгенерировать: openssl rand -base64 48)
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_ISSUER="lekalo-zhiide-api"
JWT_AUDIENCE="lekalo-zhiide-client"

# ------------------------------------------------------------------------------
# CORS и сетевая безопасность
# Список доверенных Origin через запятую (без пробелов)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="https://lekalojiide.vercel.app,https://lekalo-zhiide.kg,https://www.lekalo-zhiide.kg,https://admin.lekalo-zhiide.kg"

# ------------------------------------------------------------------------------
# Финансовые настройки и платёжные шлюзы
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY="KGS"
PAYMENT_GATEWAY="mock"
PAYMENT_WEBHOOK_SECRET="replace-with-payment-gateway-webhook-secret-at-least-32-chars"

# ------------------------------------------------------------------------------
# Хранилище цифровых выкроек и изображений (Storage)
# STORAGE_DRIVER: "mock" (для локальной разработки и тестов) или "s3" / "supabase"
# ------------------------------------------------------------------------------
STORAGE_DRIVER="mock"
STORAGE_SIGNING_SECRET="replace-with-storage-signing-secret-at-least-32-chars"
S3_ENDPOINT="https://susoqzykfmwivajdkvtb.storage.supabase.co/storage/v1/s3"
S3_REGION="ap-south-1"
S3_PUBLIC_BUCKET="product-images"
S3_PRIVATE_BUCKET="pattern-files"
S3_ACCESS_KEY_ID="replace-with-s3-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-s3-secret-access-key"

# ------------------------------------------------------------------------------
# Frontend перенаправления и API маршрутизация
# ------------------------------------------------------------------------------
INTERNAL_API_URL="http://backend:4000"
NEXT_PUBLIC_API_URL="https://lekalo-zhiide.kg"
